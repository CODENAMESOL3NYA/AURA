
# ==========================================
# Dependencies — all projects
# ==========================================
node_modules/
**/node_modules/

# ==========================================
# Environment variables and secrets
# Keep example templates tracked
# ==========================================
.env
.env.*
!.env.example
!.env.sample
!.env.template
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Private keys, certificates and credentials
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
service-account*.json
*-service-account.json
google-services.json
GoogleService-Info.plist

# ==========================================
# Build output — Vite, React, Node tooling
# ==========================================
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.vite/
**/.vite/
*.tsbuildinfo

# ==========================================
# Logs and diagnostic output
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Capacitor / Android
# Keep android/ source files tracked
# ==========================================
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/externalNativeBuild/
android/.cxx/
android/app/google-services.json

# Gradle-generated files
.gradle/
**/.gradle/

# ==========================================
# iOS / Xcode
# Keep native source and project files tracked
# ==========================================
ios/App/Pods/
ios/Pods/
ios/build/
ios/DerivedData/
**/xcuserdata/
*.xcuserstate
DerivedData/

# ==========================================
# Capacitor and local tooling
# ==========================================
.capacitor/
.capacitor-*
.tmp/
temp/

# ==========================================
# Operating system files
# ==========================================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ==========================================
# Editors and IDEs
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ==========================================
